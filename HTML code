<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tasty Foods</title>

    <!-- CSS File -->
    <link rel="stylesheet" href="style.css">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
</head>

<body>

    <!-- ================= HEADER ================= -->

    <header>

        <div class="logo">
            <h2>🍔 Tasty Foods</h2>
        </div>

        <nav>

            <ul>

                <li><a href="#home">Home</a></li>

                <li><a href="#about">About</a></li>

                <li><a href="#menu">Menu</a></li>

                <li><a href="#restaurant">Restaurants</a></li>

                <li><a href="#order">Order</a></li>

                <li><a href="#rating">Ratings</a></li>

                <li><a href="#contact">Contact</a></li>

                <li><a href="login.html">Login</a></li>

            </ul>

        </nav>

    </header>

    <!-- ================= HOME ================= -->

    <section class="home" id="home">

        <div class="home-content">

            <h1>Delicious Food Delivered To Your Door</h1>

            <p>
                Enjoy fresh, delicious, and healthy meals from your favorite
                restaurants at affordable prices.
            </p>

            <a href="#menu" class="btn">Order Now</a>

        </div>

        <div class="home-image">

            <img src="images/burger.png" alt="Burger">

        </div>

    </section>

    <!-- ================= ABOUT ================= -->

    <section class="about" id="about">

        <h2>About Us</h2>

        <p>

            Welcome to <b>Tasty Foods</b>, your one-stop destination for
            delicious meals from the best restaurants. We are committed to
            delivering fresh, hygienic, and tasty food right to your doorstep.

        </p>

    </section>

    <!-- ================= MENU ================= -->

    <section class="menu" id="menu">

        <h2>Our Menu</h2>

        <div class="menu-container">

            <div class="card">

                <img src="images/burger.jpg" alt="Burger">

                <h3>Burger</h3>

                <p>Cheesy Burger</p>

                <h4>₹199</h4>

                <button>Order Now</button>

            </div>

            <div class="card">

                <img src="images/pizza.jpg" alt="Pizza">

                <h3>Pizza</h3>

                <p>Veg Cheese Pizza</p>

                <h4>₹299</h4>

                <button>Order Now</button>

            </div>

            <div class="card">

                <img src="images/biryani.jpg" alt="Biryani">

                <h3>Biryani</h3>

                <p>Chicken Biryani</p>

                <h4>₹249</h4>

                <button>Order Now</button>

            </div>

        </div>

    </section>

    <!-- ================= RESTAURANTS ================= -->

    <section class="restaurant" id="restaurant">

        <h2>Popular Restaurants</h2>

        <div class="restaurant-container">

            <div class="restaurant-card">

                <img src="images/res1.jpg" alt="Restaurant">

                <h3>Spice Hub</h3>

                <p>⭐⭐⭐⭐☆</p>

            </div>

            <div class="restaurant-card">

                <img src="images/res2.jpg" alt="Restaurant">

                <h3>Food Palace</h3>

                <p>⭐⭐⭐⭐⭐</p>

            </div>

            <div class="restaurant-card">

                <img src="images/res3.jpg" alt="Restaurant">

                <h3>Coffee Corner</h3>

                <p>⭐⭐⭐⭐☆</p>

            </div>

        </div>

    </section>

    <!-- ================= ORDER ================= -->

    <section class="order" id="order">

        <h2>Place Your Order</h2>

        <form>

            <input type="text" placeholder="Full Name">

            <input type="email" placeholder="Email">

            <input type="text" placeholder="Phone Number">

            <textarea placeholder="Delivery Address"></textarea>

            <button type="submit">Confirm Order</button>

        </form>

    </section>

    <!-- ================= RATINGS ================= -->

    <section class="rating" id="rating">

        <h2>Customer Reviews</h2>

        <div class="review">

            <h3>⭐⭐⭐⭐⭐</h3>

            <p>"Excellent food quality and super-fast delivery."</p>

        </div>

        <div class="review">

            <h3>⭐⭐⭐⭐⭐</h3>

            <p>"Amazing taste with affordable prices."</p>

        </div>

    </section>

    <!-- ================= CONTACT ================= -->

    <section class="contact" id="contact">

        <h2>Contact Us</h2>

        <form>

            <input type="text" placeholder="Your Name">

            <input type="email" placeholder="Email">

            <textarea placeholder="Message"></textarea>

            <button type="submit">Send Message</button>

        </form>

    </section>

    <!-- ================= FOOTER ================= -->

    <footer>

        <h3>🍔 Tasty Foods</h3>

        <p>Fresh Food | Fast Delivery | Best Quality</p>

        <div class="social">

            <a href="#"><i class="fab fa-facebook"></i></a>

            <a href="#"><i class="fab fa-instagram"></i></a>

            <a href="#"><i class="fab fa-twitter"></i></a>

            <a href="#"><i class="fab fa-linkedin"></i></a>

        </div>

        <p>&copy; 2026 Tasty Foods. All Rights Reserved.</p>

    </footer>

</body>
</html>
